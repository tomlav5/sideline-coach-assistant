# Copy this file to .env and fill in values for your Supabase project.
# .env is gitignored — never commit real values.

# Supabase project URL, e.g. https://<project-id>.supabase.co
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Supabase project ID (used to derive the URL if VITE_SUPABASE_URL is not set)
VITE_SUPABASE_PROJECT_ID="your-project-id"

# Supabase publishable/anon key (either name works — client.ts checks both)
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"
VITE_SUPABASE_ANON_KEY="your-anon-key"
